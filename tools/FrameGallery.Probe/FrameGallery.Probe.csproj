<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameGallery.Core\FrameGallery.Core.csproj" />
    <ProjectReference Include="..\..\src\FrameGallery.Imaging\FrameGallery.Imaging.csproj" />
    <!-- the same token protection (DPAPI on Windows, so the same tvs.json) and data folder as the app -->
    <Compile Include="..\..\src\FrameGallery.Desktop\Services\SecretProtectors.cs" Link="SecretProtectors.cs" />
    <Compile Include="..\..\src\FrameGallery.Desktop\Services\AppPaths.cs" Link="AppPaths.cs" />
  </ItemGroup>

</Project>
