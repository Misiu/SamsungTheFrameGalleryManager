<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>   <!-- only to get ProtectedData (DPAPI) and System.Drawing from the desktop framework -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameGallery.Core\FrameGallery.Core.csproj" />
    <ProjectReference Include="..\..\src\FrameGallery.Imaging\FrameGallery.Imaging.csproj" />
    <!-- the same token protection (DPAPI, so the same tvs.json) as the app -->
    <Compile Include="..\..\src\FrameGallery.App\DpapiSecretProtector.cs" Link="DpapiSecretProtector.cs" />
    <!-- the same image pipeline as the app -->
    <Compile Include="..\..\src\FrameGallery.App\ImageIO.cs" Link="ImageIO.cs" />
  </ItemGroup>

</Project>
