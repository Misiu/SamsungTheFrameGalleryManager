<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>   <!-- tylko po to, by mieć ProtectedData (DPAPI) z frameworku desktopowego -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FrameGallery.Core\FrameGallery.Core.csproj" />
    <ProjectReference Include="..\..\src\FrameGallery.Imaging\FrameGallery.Imaging.csproj" />
    <!-- ten sam magazyn TV (tvs.json, token DPAPI) co w aplikacji -->
    <Compile Include="..\..\src\FrameGallery.App\DpapiSecretProtector.cs" Link="DpapiSecretProtector.cs" />
    <Compile Include="..\..\src\FrameGallery.App\ImageIO.cs" Link="ImageIO.cs" />   <!-- ten sam potok obrazu co w aplikacji -->
  </ItemGroup>

</Project>
