<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Image processing without System.Drawing (Windows only): SkiaSharp works on Windows, macOS, Linux, Android and iOS. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />   <!-- the version Avalonia.Skia 12.1 uses; mixing versions breaks rendering -->
    <ProjectReference Include="..\FrameGallery.Core\FrameGallery.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrameGallery.Tests" />
  </ItemGroup>

</Project>
