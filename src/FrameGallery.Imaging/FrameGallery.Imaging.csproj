<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Obróbka obrazu bez System.Drawing (tylko Windows): SkiaSharp działa na Windows, macOS, Linux, Android i iOS. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.156.0" />
    <ProjectReference Include="..\FrameGallery.Core\FrameGallery.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrameGallery.Tests" />
  </ItemGroup>

</Project>
