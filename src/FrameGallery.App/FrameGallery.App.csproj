<Project Sdk="Microsoft.NET.Sdk">

  <!-- Binternal (NuGet) merges the referenced projects into FrameGallery.App.dll as internal types, so the app ships as a single
       assembly instead of one DLL per project. -->
  <ItemGroup>
    <ProjectReference Include="..\FrameGallery.Core\FrameGallery.Core.csproj" Internalize="true" />
    <ProjectReference Include="..\FrameGallery.Localization\FrameGallery.Localization.csproj" Internalize="true" />
    <PackageReference Include="Binternal" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The icon (several sizes) is embedded in the exe once, here. The forms read it back from the exe instead of embedding it again. -->
    <ApplicationIcon>..\..\assets\icon\AppIcon.ico</ApplicationIcon>
    <!-- The merged assembly has no dependencies besides the framework, so the .deps.json file is not needed. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <!-- DotnetRuntimeBootstrapper (NuGet): replaces the exe with a bootstrapper that installs a missing .NET Desktop Runtime by itself.
       It normally runs only on publish; here it is enabled for every build. Note: the bootstrapper host does not support debugging,
       so to debug build with -p:GenerateBootstrapperOnBuild=false. -->
  <PropertyGroup>
    <GenerateBootstrapperOnBuild>true</GenerateBootstrapperOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotnetRuntimeBootstrapper" Version="2.5.4" PrivateAssets="all" />
  </ItemGroup>

</Project>