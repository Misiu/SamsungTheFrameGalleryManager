<UserControl
    x:Class="FrameGallery.Desktop.Views.CropView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FrameGallery.Desktop.Controls"
    xmlns:loc="using:FrameGallery.Desktop.Markup"
    xmlns:vm="using:FrameGallery.Desktop.ViewModels"
    x:DataType="vm:CropViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: Back, the file's name, and the two ways out -->
        <Border Grid.Row="0" Classes="bar top">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <!-- The title takes what the buttons leave; only if the file name does not fit, its end is replaced with dots (the extension stays). -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Button Command="{Binding GoBackCommand}" IsEnabled="{Binding CanLeave}" ToolTip.Tip="{loc:Loc Nav_Back}"
                            AutomationProperties.Name="{loc:Loc Nav_Back}">
                        <PathIcon Data="{StaticResource IconBack}" />
                    </Button>
                    <c:FileNameTextBlock Grid.Column="1" Classes="title" Format="{loc:Loc Crop_Title}" FileName="{Binding FileName}" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding GoBackCommand}" IsEnabled="{Binding CanLeave}" Content="{loc:Loc Crop_Skip}" />
                    <Button x:Name="UseButton" Classes="primary" Click="Use_Click" Content="{loc:Loc Crop_Use}" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Panel Grid.Row="1" Margin="14">
            <c:CropCanvas x:Name="Canvas" />

            <!-- Loading the photo or preparing the result -->
            <Border x:Name="BusyOverlay" Background="{DynamicResource OverlayBrush}" CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <c:Spinner Width="60" Height="60" HorizontalAlignment="Center" />
                    <TextBlock x:Name="BusyText" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Panel>

        <Border Grid.Row="2" Classes="bar bottom">
            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="Info" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{loc:Loc Crop_Hint}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
