<Window
    x:Class="FrameGallery.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="using:FrameGallery.Desktop.Views"
    xmlns:vm="using:FrameGallery.Desktop.ViewModels"
    x:DataType="vm:ShellViewModel"
    Title="{Binding Title}"
    Width="1037" Height="740" MinWidth="680" MinHeight="460"
    Icon="/Assets/icon.png"
    WindowStartupLocation="CenterScreen">

    <!-- The start width fits four gallery tiles exactly (4 x 254 px plus 12 px each side), so the gaps left and right are equal. -->
    <!-- One window: the list of TVs, a gallery or the crop screen, whichever is on top of the shell's stack. -->
    <Window.DataTemplates>
        <DataTemplate x:DataType="vm:TvListViewModel"><v:TvListView /></DataTemplate>
        <DataTemplate x:DataType="vm:GalleryViewModel"><v:GalleryView /></DataTemplate>
        <DataTemplate x:DataType="vm:CropViewModel"><v:CropView /></DataTemplate>
    </Window.DataTemplates>

    <!-- The screens fade into each other. -->
    <TransitioningContentControl Content="{Binding Current}">
        <TransitioningContentControl.PageTransition>
            <CrossFade Duration="0:0:0.2" />
        </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>
</Window>
