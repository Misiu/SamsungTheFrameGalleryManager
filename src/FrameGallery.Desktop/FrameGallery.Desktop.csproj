<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The cross-platform UI (Avalonia). It replaces the WinForms prototype in src/FrameGallery.App. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FrameGallery</AssemblyName>
    <RootNamespace>FrameGallery.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The windows are created in code with constructor arguments, so the design-time runtime loader cannot create them; that is fine. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <ApplicationIcon>..\..\assets\icon\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameGallery.Core\FrameGallery.Core.csproj" />
    <ProjectReference Include="..\FrameGallery.Imaging\FrameGallery.Imaging.csproj" />
    <ProjectReference Include="..\FrameGallery.Localization\FrameGallery.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrameGallery.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same artwork as the executable's icon, for the window icon and the header. -->
    <AvaloniaResource Include="..\..\assets\icon\icon.png" Link="Assets\icon.png" />
  </ItemGroup>

</Project>
