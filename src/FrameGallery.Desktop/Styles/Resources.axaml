<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Our own palette (light and dark), so the look does not depend on the names of the theme resources. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AccentColor">#2F6BFF</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="#2F6BFF" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F5FA" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#E1E5EE" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7385" />
            <SolidColorBrush x:Key="TilePlaceholderBrush" Color="#E6EAF3" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#B3F3F5FA" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AccentColor">#6C95FF</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="#6C95FF" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#14161C" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2129" />
            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#2C303B" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA3B8" />
            <SolidColorBrush x:Key="TilePlaceholderBrush" Color="#262A34" />
            <SolidColorBrush x:Key="OverlayBrush" Color="#B314161C" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 24x24 vector icons (Material Design icons, Apache-2.0) -->
