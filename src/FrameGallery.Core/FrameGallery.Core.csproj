<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No platform or UI dependencies: the same code for WinForms, Avalonia and other UI frameworks.
         net8.0 = lowest common denominator for UI frameworks, net10.0 = current. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrameGallery.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameGallery.Localization\FrameGallery.Localization.csproj" />
  </ItemGroup>

</Project>
